# Vercel Serverless API Environment Variables
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# .env dosyasını ASLA Git'e commit etmeyin!

# ScraperAPI Key (api/scrape-price.js tarafından kullanılır)
SCRAPER_API_KEY=buraya_gercek_api_keyinizi_yazin

# Firebase Config (opsiyonel - CDN projesinde window.__ENV__ ile kullanılabilir)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
